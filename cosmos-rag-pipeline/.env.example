# Cosmos DB connection settings
COSMOS_URI=https://<your-account-name>.documents.azure.com:443/
COSMOS_KEY=<your-primary-key>
COSMOS_DB=<cosmos-db-name>
COSMOS_CONTAINER=<cosmos-container-name>

# Optional: other environment variables for extensions
# OPENAI_API_KEY=<your-openai-key>
# LOG_LEVEL=INFO